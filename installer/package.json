{
  "name": "k11c-installer",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build:web": "vue-tsc --noEmit && vite build",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test": "node scripts/test-i18n.mjs && node scripts/test-theme.mjs && node scripts/test-ui.mjs && node scripts/verify.mjs",
    "test:theme": "node scripts/test-theme.mjs",
    "test:theme:mutation": "node scripts/test-theme.mjs --mutation",
    "test:appearance": "node scripts/test-appearance-browser.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:i18n:mutation": "node scripts/test-i18n.mjs --mutation",
    "test:ui": "node scripts/test-ui.mjs",
    "test:ui:mutation": "node scripts/test-ui.mjs --mutation",
    "test:mutation": "node scripts/mutation.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
