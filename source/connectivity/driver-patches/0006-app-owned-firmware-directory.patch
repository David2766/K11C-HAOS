From e75f8185421db29639983256857d95aa00a09b37 Mon Sep 17 00:00:00 2001
From: K11C HAOS Port <k11c-haos@localhost>
Date: Tue, 1 Sep 2026 14:10:00 +0800
Subject: [PATCH 6/6] skw: allow firmware in an app-owned host directory

HAOS keeps the root filesystem immutable and an app cannot write the host
firmware search path.  Add a firmware_path module parameter to each of the
three K11C modules.  When set, firmware is read from that absolute path in
the initial mount namespace.  This lets a protected Home Assistant app own
the blobs in its normal data directory without requiring host PID, mount,
or full hardware access.

The normal kernel firmware loader remains the fallback when firmware_path
is empty.
---
 include/linux/platform_data/skw_firmware.h     | 67 ++++++++++++++++++++++++++
 seekwaveplatform_lite/skwutil/skw_boot.c       | 14 ++++--
 skwbt/skw_btdriver.c                           | 13 +++--
 swt6621s_wifi/skw_compat.h                     |  6 ++-
 swt6621s_wifi/skw_core.c                       |  8 ++-
 5 files changed, 101 insertions(+), 7 deletions(-)
 create mode 100644 include/linux/platform_data/skw_firmware.h

diff --git a/include/linux/platform_data/skw_firmware.h b/include/linux/platform_data/skw_firmware.h
new file mode 100644
index 0000000..9d6aadb
--- /dev/null
+++ b/include/linux/platform_data/skw_firmware.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __SKW_FIRMWARE_H__
+#define __SKW_FIRMWARE_H__
+
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/firmware.h>
+#include <linux/kernel_read_file.h>
+#include <linux/limits.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+
+#define SKW_FIRMWARE_PATH_MAX 512
+
+static inline int
+skw_request_firmware_from_directory(const struct firmware **firmware,
+                                    const char *directory,
+                                    const char *name,
+                                    struct device *device)
+{
+	struct firmware *fw;
+	void *data = NULL;
+	char *path;
+	size_t size = 0;
+	ssize_t ret;
+
+	if (!directory || !directory[0])
+		return request_firmware(firmware, name, device);
+
+	if (directory[0] != '/' || !name || !name[0] || strchr(name, '/'))
+		return -EINVAL;
+
+	path = kasprintf(GFP_KERNEL, "%s/%s", directory, name);
+	if (!path)
+		return -ENOMEM;
+
+	fw = kzalloc(sizeof(*fw), GFP_KERNEL);
+	if (!fw) {
+		kfree(path);
+		return -ENOMEM;
+	}
+
+	ret = kernel_read_file_from_path_initns(path, 0, &data, INT_MAX, &size,
+						 READING_FIRMWARE);
+	kfree(path);
+	if (ret < 0)
+		goto error;
+
+	if (ret != size) {
+		ret = -EFBIG;
+		goto error;
+	}
+
+	fw->size = size;
+	fw->data = data;
+	fw->priv = NULL;
+	*firmware = fw;
+
+	return 0;
+
+error:
+	vfree(data);
+	kfree(fw);
+	return ret;
+}
+
+#endif /* __SKW_FIRMWARE_H__ */
